# The AI that recognizes photos. Without it the app runs in demo mode (sample results).
ANTHROPIC_API_KEY=

# Live prices (optional; each source is skipped if its keys are missing)
# Google Shopping via SerpApi: https://serpapi.com (free tier available)
SERPAPI_KEY=
# eBay Browse API: https://developer.ebay.com (free)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Affiliate programs (optional; links earn a commission once these are set)
# Amazon Associates: https://affiliate-program.amazon.com (looks like yourname-20)
AMAZON_ASSOCIATE_TAG=
# eBay Partner Network: https://partnernetwork.ebay.com (a 10-digit campaign ID)
EBAY_CAMPAIGN_ID=
